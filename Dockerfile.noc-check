# Isolated NOC check environment: preserve the deployed 0.3.10 transport/runtime.
# Install the artifact built from nokia.isam commit 33ba8a1ff2965879af7f4b4d8d1d0e864d1a8d5f.
FROM ghcr.io/blue-networks/yplay-custom-ee@sha256:628eab3dc3628919f80214b4ccc0c6494be2aba4c17c3a7748ddc870bb249b94
USER 0
COPY nokia-isam-0.3.11.tar.gz /tmp/nokia-isam-release.tar.gz
RUN HOME=/tmp ansible-galaxy collection install /tmp/nokia-isam-release.tar.gz --force --no-deps -p /usr/share/ansible/collections
USER 1000
